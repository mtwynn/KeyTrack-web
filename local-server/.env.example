# Copy this file to `.env` and fill in your app credentials.
# The backend loads `.env` automatically (via dotenv) on every start, so you
# only set these once for local development.
#
# --- Spotify ---
# Get these from your Spotify app at https://developer.spotify.com/dashboard
# and make sure http://127.0.0.1:8888/callback is added as a Redirect URI.
SPOTIFY_ID=your_spotify_client_id
SPOTIFY_SECRET=your_spotify_client_secret

# --- SoundCloud ---
# Register an app at https://soundcloud.com/you/apps/new (requires Artist Pro).
# Add this exact Redirect URI for local dev:
#   http://127.0.0.1:8888/soundcloud/callback
# (When deploying, change the registered URI to:
#   https://key-track2.herokuapp.com/soundcloud/callback )
SOUNDCLOUD_ID=your_soundcloud_client_id
SOUNDCLOUD_SECRET=your_soundcloud_client_secret

# --- Analysis microservice ---
# Where the key/BPM analysis service runs. Defaults to localhost for dev (run
# `cd analysis-service && node server.js`). In prod, point at the deployed
# Fly.io/Render URL.
# ANALYSIS_SERVICE_URL=http://127.0.0.1:8899

# --- Artwork Explorer: Gemini vision (optional) ---
# Powers semantic tags, content search ("foggy neon city at night") and
# find-similar in Artwork Explorer. WITHOUT this the feature still works —
# colour/mood analysis runs free in the browser — you just lose the semantic
# layer.
#
# Get a key at https://aistudio.google.com/apikey. Keep it HERE: anything in the
# React bundle is world-readable, so the key must never reach the client.
#
# Each unique album cover is analyzed once and cached forever, so cost is
# one-time. A ~1,500-cover library runs to a few dollars on the paid tier; the
# free tier works too but caps at ~1,000 requests/day.
# GEMINI_API_KEY=your_gemini_api_key
# Optional model override (default: gemini-2.5-flash-lite)
# GEMINI_VISION_MODEL=gemini-2.5-flash-lite
